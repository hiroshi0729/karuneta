<% content_for(:title, "カテゴリ管理 | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-6">
  <h1 class="text-2xl font-bold">カテゴリ管理</h1>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold">カテゴリを追加</h2>

    <%= form_with model: @category, class: "mt-4 flex flex-col gap-4" do |f| %>
      <%= render "form_fields", f: f, category: @category %>

      <%= f.submit "追加する", class: "mt-2 block w-full cursor-pointer rounded-md bg-primary py-3 text-center font-bold text-white" %>
    <% end %>
  </div>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <% if @categories.any? %>
      <ul class="divide-y divide-gray-200">
        <% @categories.each do |category| %>
          <li class="flex items-center gap-3 py-3">
            <span class="h-4 w-4 shrink-0 rounded-full" style="background-color: <%= category.color %>;"></span>
            <span class="min-w-0 flex-1 break-all"><%= category.name %></span>
            <div class="flex shrink-0 items-center gap-2">
              <%= link_to "編集", edit_category_path(category),
                          class: "rounded-md border border-primary bg-white px-3 py-1 text-sm font-bold text-primary" %>
              <%= button_to category_path(category), method: :delete,
                            form: { data: { turbo_confirm: "カテゴリ「#{category.name}」を削除しますか？" } },
                            class: "flex h-9 w-9 items-center justify-center rounded-md text-gray-500 hover:text-red-600",
                            aria: { label: "削除" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center text-sm text-gray-500">まだカテゴリがありません</p>
    <% end %>
  </div>
</div>
