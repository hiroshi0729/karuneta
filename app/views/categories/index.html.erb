<% content_for(:title, "カテゴリ管理 | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-6">
  <h1 class="text-2xl font-bold">カテゴリ管理</h1>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold">カテゴリを追加</h2>

    <%= form_with model: @category, class: "mt-4 flex flex-col gap-4" do |f| %>
      <% if @category.errors.any? %>
        <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @category.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-bold" %>
        <%= f.text_field :name, placeholder: "例：Web集客",
                         class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <fieldset>
        <legend class="block text-sm font-bold"><%= Category.human_attribute_name(:color) %></legend>
        <div class="mt-2 flex gap-4">
          <% Category::COLORS.each do |color| %>
            <label class="cursor-pointer">
              <%= f.radio_button :color, color, class: "peer sr-only" %>
              <span class="block h-9 w-9 rounded-full ring-offset-2 peer-checked:ring-2 peer-checked:ring-ink peer-focus-visible:ring-2 peer-focus-visible:ring-primary"
                    style="background-color: <%= color %>;"></span>
              <span class="sr-only"><%= color %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <%= f.submit "追加する", class: "mt-2 block w-full cursor-pointer rounded-md bg-primary py-3 text-center font-bold text-white" %>
    <% end %>
  </div>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <% if @categories.any? %>
      <ul class="divide-y divide-gray-200">
        <% @categories.each do |category| %>
          <li class="flex items-center gap-3 py-3">
            <span class="h-4 w-4 shrink-0 rounded-full" style="background-color: <%= category.color %>;"></span>
            <span class="break-all"><%= category.name %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center text-sm text-gray-500">まだカテゴリがありません</p>
    <% end %>
  </div>
</div>
