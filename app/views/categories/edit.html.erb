<% content_for(:title, "カテゴリを編集 | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-6">
  <h1 class="text-2xl font-bold">カテゴリを編集</h1>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <%= form_with model: @category, class: "flex flex-col gap-4" do |f| %>
      <%= render "form_fields", f: f, category: @category %>

      <%= f.submit "更新する", class: "mt-2 block w-full cursor-pointer rounded-md bg-primary py-3 text-center font-bold text-white" %>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "キャンセル（カテゴリ管理に戻る）", categories_path, class: "text-sm font-bold text-primary" %>
  </div>
</div>
