<% content_for(:title, "ログイン | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-10">
  <h1 class="text-center text-2xl font-bold">ログイン</h1>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <%= form_with url: login_path, class: "flex flex-col gap-4" do |f| %>
      <div>
        <%= f.label :email, User.human_attribute_name(:email), class: "block text-sm font-bold" %>
        <%= f.email_field :email, value: params[:email], placeholder: "example@mail.com", autocomplete: "email",
                          class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, User.human_attribute_name(:password), class: "block text-sm font-bold" %>
        <%= f.password_field :password, placeholder: "パスワードを入力", autocomplete: "current-password",
                             class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <%= f.submit "ログインする", class: "mt-2 block w-full cursor-pointer rounded-md bg-primary py-3 text-center font-bold text-white" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm">
    アカウントをお持ちでない方は<%= link_to "こちら（新規登録）", new_user_path, class: "font-bold text-primary underline" %>
  </p>
</div>
