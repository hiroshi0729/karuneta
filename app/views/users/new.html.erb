<% content_for(:title, "新規登録 | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-10">
  <h1 class="text-center text-2xl font-bold">新規登録</h1>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <%= form_with model: @user, class: "flex flex-col gap-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-bold" %>
        <%= f.text_field :name, placeholder: "例：山田 太郎", autocomplete: "username",
                         class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-bold" %>
        <%= f.email_field :email, placeholder: "example@mail.com", autocomplete: "email",
                          class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-bold" %>
        <%= f.password_field :password, placeholder: "8文字以上", autocomplete: "new-password",
                             class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-bold" %>
        <%= f.password_field :password_confirmation, placeholder: "もう一度入力", autocomplete: "new-password",
                             class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <%= f.submit "登録する", class: "mt-2 block w-full cursor-pointer rounded-md bg-primary py-3 text-center font-bold text-white" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm">
    アカウントをお持ちの方は<%= link_to "こちら（ログイン）", "#", class: "font-bold text-primary underline" %>
  </p>
</div>
