<% content_for(:title, "ネタ一覧 | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-6">
  <h1 class="text-2xl font-bold">ネタ一覧</h1>

  <div class="mt-4 flex flex-wrap gap-2">
    <%= link_to "すべて", posts_path, class: status_filter_class(current_status_filter.nil?) %>
    <% Post.statuses.each_key do |status| %>
      <%= link_to Post.status_label_for(status), posts_path(status: status),
                  class: status_filter_class(current_status_filter == status) %>
    <% end %>
  </div>

  <div class="mt-6 flex flex-col gap-3">
    <% if @posts.any? %>
      <%= render partial: "posts/card", collection: @posts, as: :post %>
    <% else %>
      <p class="rounded-lg bg-white p-6 text-center text-sm text-gray-500 shadow-sm">
        <%= current_status_filter ? "このステータスのネタはありません" : "まだネタがありません" %>
      </p>
    <% end %>
  </div>

  <%= link_to "＋ ネタを登録", new_post_path,
              class: "mt-6 block w-full rounded-md bg-primary py-3 text-center font-bold text-white" %>
</div>
