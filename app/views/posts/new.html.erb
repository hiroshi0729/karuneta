<% content_for(:title, "ネタを登録 | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-6">
  <h1 class="text-2xl font-bold">ネタを登録</h1>
  <p class="mt-2 text-sm text-gray-500">タイトルだけでも登録できます。カテゴリやメモはあとから追加できます。</p>

  <div class="mt-6 rounded-lg bg-white p-6 shadow-sm">
    <%= form_with model: @post, class: "flex flex-col gap-4" do |f| %>
      <% if @post.errors.any? %>
        <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
          <ul class="list-disc pl-5">
            <% @post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :title, "#{Post.human_attribute_name(:title)}（必須）", class: "block text-sm font-bold" %>
        <%= f.text_field :title, placeholder: "例：LPの改善で問い合わせが増えた事例",
                         class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <div>
        <%= f.label :category_id, Post.human_attribute_name(:category), class: "block text-sm font-bold" %>
        <div class="relative mt-1">
          <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: "選択してください" },
                                  class: "block w-full appearance-none rounded-md border border-gray-300 bg-white py-3 pl-3 pr-10 text-base focus:border-primary focus:outline-none" %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="pointer-events-none absolute right-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-500" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </div>

      <div>
        <%= f.label :scheduled_on, class: "block text-sm font-bold" %>
        <%= f.date_field :scheduled_on,
                         class: "mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <div>
        <%= f.label :memo, class: "block text-sm font-bold" %>
        <%= f.text_area :memo, rows: 5, placeholder: "伝えたいこと・参考にしたい事例など",
                        class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-3 text-base focus:border-primary focus:outline-none" %>
      </div>

      <%= f.submit "登録する", class: "mt-2 block w-full cursor-pointer rounded-md bg-primary py-3 text-center font-bold text-white" %>
    <% end %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "キャンセル（ネタ一覧に戻る）", root_path, class: "text-sm font-bold text-primary" %>
  </div>
</div>
