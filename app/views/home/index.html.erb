<% content_for(:title, "ホーム | カルネタ") %>

<div class="mx-auto max-w-md px-4 py-6">
  <h1 class="text-2xl font-bold">次にやること</h1>

  <section class="mt-6">
    <h2 class="text-sm font-bold text-gray-500">投稿予定が近いネタ</h2>
    <div class="mt-3 flex flex-col gap-3">
      <% if @upcoming_posts.any? %>
        <%= render partial: "posts/card", collection: @upcoming_posts, as: :post %>
      <% else %>
        <p class="rounded-lg bg-white p-6 text-center text-sm text-gray-500 shadow-sm">投稿予定のネタはありません</p>
      <% end %>
    </div>
  </section>

  <section class="mt-6">
    <h2 class="text-sm font-bold text-gray-500">構成を作成中のネタ</h2>
    <div class="mt-3 flex flex-col gap-3">
      <% if @drafting_posts.any? %>
        <%= render partial: "posts/card", collection: @drafting_posts, as: :post %>
      <% else %>
        <p class="rounded-lg bg-white p-6 text-center text-sm text-gray-500 shadow-sm">構成中のネタはありません</p>
      <% end %>
    </div>
  </section>

  <div class="mt-6 grid grid-cols-2 gap-3">
    <div class="rounded-lg bg-white p-4 shadow-sm">
      <p class="text-xs text-gray-500">まだ着手していないネタ</p>
      <p class="mt-2 text-2xl font-bold"><%= @idea_count %>件</p>
    </div>
    <div class="rounded-lg bg-white p-4 shadow-sm">
      <p class="text-xs text-gray-500">投稿済み</p>
      <p class="mt-2 text-2xl font-bold"><%= @posted_count %>件</p>
    </div>
  </div>

  <%= link_to "＋ ネタを登録", new_post_path,
              class: "mt-6 block w-full rounded-md bg-primary py-3 text-center font-bold text-white" %>
</div>
